{
	"name": "api-docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"//zod": "zod pinned to 4.1.12: nextra 4.6.1 / nextra-theme-docs declare zod ^4.1.12 but 4.4.x broke z.custom() handling of undefined in the Layout schema. Revisit when Nextra ships a zod-4.4-compatible release.",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"gen:reference": "node scripts/gen-reference.mjs",
		"check:examples": "node scripts/check-examples.mjs",
		"predev": "node scripts/gen-reference.mjs",
		"prebuild": "node scripts/gen-reference.mjs && node scripts/check-examples.mjs"
	},
	"dependencies": {
		"next": "^16.3.0",
		"nextra": "^4.6.1",
		"nextra-theme-docs": "^4.6.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@graphql-markdown/cli": "^0.7.1",
		"@graphql-tools/graphql-file-loader": "^8.1.14",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"graphql": "^16.14.0",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"overrides": {
			"zod": "4.1.12"
		}
	}
}
